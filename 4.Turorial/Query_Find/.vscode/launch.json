{
  "version": "0.2.0",
  "configurations": [
   
    {
      "name": "Debug BookShop",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/BookShop",
      "preLaunchTask": "Build (CMake)",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build",
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}